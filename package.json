{
  "name": "multibot-sdk",
  "version": "0.1.1",
  "description": "Headless multi-bot host: local HTTP gateway, group chat, third-party LLMs, directory-scoped tools.",
  "license": "UNLICENSED",
  "author": "dushaobindoudou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushaobindoudou/sdk-bots.git"
  },
  "bugs": {
    "url": "https://github.com/0xrushmoon/sdk-bots/issues"
  },
  "homepage": "https://github.com/0xrushmoon/sdk-bots#readme",
  "keywords": [
    "bot",
    "multi-agent",
    "agent-orchestration",
    "group-chat",
    "headless",
    "sdk",
    "gateway",
    "sse",
    "sandbox"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/src/sdk/entry.js",
  "types": "dist/src/sdk/entry.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/sdk/entry.js",
      "types": "./dist/src/sdk/entry.d.ts"
    },
    "./host": {
      "import": "./dist/src/host/index.js",
      "types": "./dist/src/host/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run build:daemon && npm run build:workers && tsc -p tsconfig.sdk.json; node scripts/copy-build-assets.mjs",
    "typecheck": "tsc -p tsconfig.sdk.json",
    "build:daemon": "node scripts/build-box-exec-daemon.mjs",
    "build:workers": "node scripts/build-host-workers.mjs",
    "dev": "tsx src/host/index.ts",
    "start": "node dist/src/host/index.js",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "pretest:smoke": "node scripts/build-host-workers.mjs && node scripts/build-box-exec-daemon.mjs",
    "test:smoke": "tsx test/smoke.mjs",
    "test:e2e": "tsx test/e2e-mock.mjs",
    "pretest:e2e": "node scripts/build-host-workers.mjs && node scripts/build-box-exec-daemon.mjs",
    "test:e2e:openrouter": "tsx test/e2e-openrouter.mjs",
    "pretest:e2e:openrouter": "node scripts/build-host-workers.mjs && node scripts/build-box-exec-daemon.mjs",
    "pretest:integration": "node scripts/build-host-workers.mjs && node scripts/build-box-exec-daemon.mjs",
    "test:integration": "node test/integration/run.mjs",
    "example:group-chat": "tsx examples/group-chat.mjs",
    "preexample:group-chat": "node scripts/build-host-workers.mjs && node scripts/build-box-exec-daemon.mjs",
    "cleanup:smoke": "tsx scripts/cleanup-smoke-agents.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.6.1",
    "@connectrpc/connect-node": "1.6.1",
    "@jimp/core": "^1.6.1",
    "@jimp/js-bmp": "^1.6.1",
    "@jimp/js-gif": "^1.6.1",
    "@jimp/js-jpeg": "^1.6.1",
    "@jimp/js-png": "^1.6.1",
    "@jimp/js-tiff": "^1.6.1",
    "@jimp/plugin-resize": "^1.6.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "*",
    "@opentelemetry/exporter-trace-otlp-proto": "*",
    "@opentelemetry/resources": "*",
    "@opentelemetry/sdk-trace-node": "*",
    "@statsig/js-client": "^3.33.4",
    "@streamparser/json": "0.0.21",
    "ai": "4.3.17",
    "diff": "*",
    "gray-matter": "^4.0.3",
    "iconv-lite": "*",
    "ignore": "*",
    "image-type": "^6.1.0",
    "js-yaml": "^3.15.1",
    "jschardet": "*",
    "jsonc-parser": "*",
    "mime-types": "*",
    "minimatch": "*",
    "piscina": "4.9.0",
    "re2js": "*",
    "rxjs": "8.0.0-alpha.14",
    "tar": "7.5.21",
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "undici": "5.29.0",
    "ws": "8.20.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "*"
  },
  "optionalDependencies": {
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/js-yaml": "*",
    "@types/node": "*",
    "esbuild": "*",
    "tsx": "*",
    "typescript": "*"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}

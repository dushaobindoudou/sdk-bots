{
  "name": "sdk-bots",
  "version": "0.1.0",
  "description": "Headless multi-bot orchestration SDK extracted from Grok Bot 0.18 — no Electron UI, local gateway + multi-agent group chat orchestration, third-party inference providers.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sdk/index.js",
      "types": "./dist/sdk/index.d.ts"
    },
    "./host": {
      "import": "./dist/host/index.js",
      "types": "./dist/host/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.sdk.json",
    "dev": "tsx src/host/index.ts",
    "start": "node dist/host/index.js",
    "test": "tsx test/smoke.mjs",
    "test:smoke": "tsx test/smoke.mjs",
    "cleanup:smoke": "tsx scripts/cleanup-smoke-agents.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.6.1",
    "@connectrpc/connect-node": "1.6.1",
    "@jimp/core": "^1.6.1",
    "@jimp/js-bmp": "^1.6.1",
    "@jimp/js-gif": "^1.6.1",
    "@jimp/js-jpeg": "^1.6.1",
    "@jimp/js-png": "^1.6.1",
    "@jimp/js-tiff": "^1.6.1",
    "@jimp/plugin-resize": "^1.6.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "*",
    "@opentelemetry/core": "*",
    "@opentelemetry/exporter-trace-otlp-proto": "*",
    "@opentelemetry/resources": "*",
    "@opentelemetry/sdk-metrics": "*",
    "@opentelemetry/sdk-trace-base": "*",
    "@opentelemetry/sdk-trace-node": "*",
    "@opentelemetry/semantic-conventions": "*",
    "@statsig/js-client": "^3.33.4",
    "@streamparser/json": "0.0.21",
    "@tiptap/core": "^3.30.3",
    "@tiptap/html": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "ai": "4.3.17",
    "diff": "*",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "*",
    "ignore": "*",
    "image-type": "^6.1.0",
    "js-yaml": "^3.15.1",
    "jschardet": "*",
    "jsonc-parser": "*",
    "katex": "^0.18.4",
    "mime-types": "*",
    "minimatch": "*",
    "piscina": "4.9.0",
    "playwright-core": "^1.62.1",
    "re2js": "*",
    "rxjs": "8.0.0-alpha.14",
    "tar": "7.5.21",
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "undici": "5.29.0",
    "web-tree-sitter": "*",
    "ws": "8.20.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "*"
  },
  "devDependencies": {
    "@types/js-yaml": "*",
    "@types/node": "*",
    "esbuild": "*",
    "tsx": "*",
    "typescript": "*"
  },
  "files": [
    "dist",
    "source",
    "README.md"
  ]
}
